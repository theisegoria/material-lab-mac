    "Always on while Repair albedo is on: a repaired albedo tiles.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アルベドを修復」がオンの間は常にオンです。修復したアルベドはタイル化できます。"
          }
        }
      }
    },
