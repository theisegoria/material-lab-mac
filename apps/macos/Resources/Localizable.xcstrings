    "Wood planks": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "木の板"
          }
        }
      }
    },
    "Worst wrap step as a multiple of an ordinary neighbouring step (1× or below shows no seam). Method: %@, band %lld %%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Worst wrap step as a multiple of an ordinary neighbouring step (1× or below shows no seam). Method: %1$@, band %2$lld %%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折り返し部分の最大の段差を、通常の隣接ピクセル間の段差の倍数で示します（1×以下なら継ぎ目なし）。方式：%@、帯 %lld%%。"
          }
        }
      }
    },
    "Wrap filters at edges": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端でフィルタを折り返す"
          }
        }
      }
    },
    "Your grayscale ambient occlusion map (white is open) replaces the estimate.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グレースケールのアンビエントオクルージョンマップ（白は遮蔽なし）が推定値の代わりに使われます。"
          }
        }
      }
    },
    "Your grayscale metalness map (white is metal) fills the ORM map's metalness.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グレースケールのメタルネスマップ（白が金属）がORMマップのメタルネスに使われます。"
          }
        }
      }
    },
    "Your grayscale roughness map (white is rough) replaces the estimate.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グレースケールのラフネスマップ（白が粗い）が推定値の代わりに使われます。"
          }
        }
      }
    },
