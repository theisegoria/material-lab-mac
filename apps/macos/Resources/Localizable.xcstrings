    "Base Color, Normal, Mask Map (metallic, occlusion, detail, smoothness) and Height.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースカラー、ノーマル、マスクマップ（メタリック、オクルージョン、ディテール、スムースネス）、高さ。"
          }
        }
      }
    },
    "Base Map, Normal, Metallic with smoothness in alpha, Occlusion and Height.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースマップ、ノーマル、アルファにスムースネスを含むメタリック、オクルージョン、高さ。"
          }
        }
      }
    },
    "Base color with lighting optionally flattened.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライティングを必要に応じて平坦化したベースカラー。"
