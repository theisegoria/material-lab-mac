            "state": "translated",
            "value": "表示"
          }
        }
      }
    },
    "Waiting for approval on Mac…": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macでの承認を待っています…"
          }
        }
      }
    },
    "Weight of MoGe-2 learned geometry: large-scale form and which way the fine detail points. 0 analytic only; at 1 the fine grain still comes from the photo, oriented by the learned surface.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MoGe-2学習ジオメトリの重み：大きな形状と細部の向きに影響します。0は解析のみ。1でも細かな質感は写真から取り、学習した表面に沿って向きを決めます。"
          }
        }
      }
    },
    "Weights SHA-256": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重みのSHA-256"
          }
        }
      }
    },
    "Welcome to Material Lab": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Material Labへようこそ"
          }
        }
      }
    },
    "Width of the edge band, per edge, as a fraction of the image. 0 leaves the edges untouched.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各辺の帯の幅（画像に対する割合）。0の場合は端を変更しません。"
          }
        }
      }
    },
    "Wood": {
      "extractionState": "manual",
