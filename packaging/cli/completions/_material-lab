#compdef material-lab
# zsh completion for material-lab

local -a presets formats repairs
presets=(red-brick painted-brick cinder-block rubble-wall cobblestone slate sandstone polished-marble terracotta-roof roof-shingles concrete polished-concrete plaster stucco asphalt ceramic-tile floor-tile wood-planks varnished-wood raw-wood bark soil sand gravel grass moss canvas denim carpet leather brushed-steel galvanized-steel diamond-plate copper rusted-steel painted-metal plastic rubber cardboard flat stone fabric organic coated-metal bare-metal)
formats=(glb usdz materialx unreal unity unity-hdrp godot blender substance roblox minecraft-labpbr)
repairs=(off auto quilt blend)

_arguments -s \
  '--input[source image]:image:_files -g "*.(png|jpg|jpeg|tif|tiff|heic|webp)(-.)"' \
  '--output[output bundle, folder or file]:path:_files' \
  '--catalog[catalog JSON]:catalog:_files -g "*.json(-.)"' \
  '--watch[folder to watch for new images]:folder:_files -/' \
  '--validate[bundle or capture to validate]:path:_files' \
  '--label[semantic label]:label:' \
  '--id[material id]:id:' \
  "--preset[material preset or relief prior]:preset:(${presets})" \
  '--list-presets[list the material presets]' \
  '--height-strength[relief amplitude 0..0.5]:value:' \
  '--polarity[bright details raised (1) or recessed (-1)]:polarity:(1 -1)' \
  '--normal-strength[normal intensity 0..16]:value:' \
  '--roughness[roughness prior 0..1]:value:' \
  '--roughness-variation[roughness variation 0..1]:value:' \
  '--roughness-albedo-limit[max roughness/brightness correlation 0..1]:value:' \
  '--mid-relief-share[4-30 mm relief floor 0..0.8]:value:' \
  '--tile-metres[physical tile width in metres]:value:' \
  '--substrate-relief[flat preset surface unevenness 0..1]:value:' \
  '--ao-radius[occlusion radius in pixels]:value:' \
  '--ao-strength[occlusion depth 0..4]:value:' \
  '--equalize[remove lighting 0..1]:value:' \
  '--seamless[tileable edge band 0..0.45]:value:' \
  '--seamless-mode[tiling method]:mode:(cut blend)' \
  "--repair-albedo[rebuild the albedo to tile]:repair:(${repairs})" \
  '--metalness[assigned metalness 0..1]:value:' \
  '--authored[the input is a hand-made albedo]' \
  '--height-map[authored height image]:image:_files' \
  '--normal-map[authored normal map]:image:_files' \
  '--normal-map-dx[the authored normal map is DirectX]' \
  '--roughness-map[authored roughness image]:image:_files' \
  '--ao-map[authored ambient occlusion image]:image:_files' \
  '--metalness-map[authored metalness image]:image:_files' \
  '--normal-dx[DirectX green-down normals]' \
  '--no-tile[do not wrap filters at the edges]' \
  '--relief-mask-r8[raw 8-bit relief mask]:file:_files' \
  '--height-override-r16le[raw 16-bit authored height]:file:_files' \
  '--pre-upscale-exec[local upscaler executable]:executable:_files' \
  '*--pre-upscale-arg[upscaler argument]:argument:' \
  '--pre-upscale-timeout[upscaler timeout in seconds]:seconds:' \
  '--resolution[derive at 4096 or 8192]:size:(4096 8192)' \
  '--upscaler-root[pinned Real-ESRGAN vendor project]:folder:_files -/' \
  '--upscaler-device[upscaler device]:device:(cpu mps)' \
  '--guide-measured[measured normal or depth map from a scanner]:image:_files' \
  '--guide-measured-dx[the measured normal map is DirectX]' \
  '--measured-depth-mm[depth the measured map spans]:mm:' \
  '--variant[seeded variant]:seed:' \
  '--variant-strength[variant shift scale 0..3]:value:' \
  '--variant-rotate[variant may turn and mirror]' \
  '--large-tile[non-repeating tile size]:tiles:(2 4)' \
  '--large-tile-seed[large-tile seed]:seed:' \
  '--large-tile-patch[large-tile patch fraction 0.125..1]:value:' \
  '--base[layer: base bundle]:bundle:_files -/' \
  '--top[layer: top bundle]:bundle:_files -/' \
  '--mask[layer: height, slope, noise or a mask image]:mask:{_alternative "kinds:kind:(height slope noise)" "files:image:_files"}' \
  '--threshold[layer mask threshold 0..1]:value:' \
  '--softness[layer mask softness 0..0.5]:value:' \
  '--invert[layer mask inverted]' \
  '--seed[layer noise seed]:seed:' \
  '--scale[layer noise cells per tile]:value:' \
  '--contrast[layer noise contrast]:value:' \
  '--height-blend[layer height-aware blend 0..0.95]:value:' \
  '--normal-blend[layer normal blend]:mode:(height reoriented)' \
  '--bent-normal[write a bent normal map]' \
  '--learned[use the bundled learned-geometry model]' \
  '--learned-normals[Core ML model]:model:_files' \
  '--learned-cpu-only[run the model on the CPU]' \
  '--guide-normals[precomputed +Y normals PNG]:png:_files -g "*.png(-.)"' \
  '--guide-weight[learned geometry weight 0..1]:value:' \
  '--save-guide-normals[write the guide normals]:png:_files' \
  '--recipe[recipe JSON or bundle]:recipe:_files' \
  '--saved-recipe[recipe saved in the Mac app]:name:' \
  '--save-recipe[write the recipe as JSON]:file:_files' \
  "--also-export[comma-separated formats]:formats:_sequence compadd - ${formats}" \
  '--jobs[parallel catalog items 1..8]:jobs:(1 2 3 4)' \
  '--report[per-item JSON report]:file:_files' \
  '--keep-going[continue after a failed item]' \
  '--include-unreviewed[include unreviewed catalog items]' \
  '--info[describe a bundle]:bundle:_files -/' \
  '--contact-sheet[one image of every map]:bundle:_files -/' \
  '--preview[a lit render of a bundle]:bundle:_files -/' \
  '--diff[compare two bundles]:bundle:_files -/:bundle:_files -/' \
  '--export[export a bundle]:bundle:_files -/' \
  "--format[export format]:format:(${formats})" \
  '--json[machine-readable output]' \
  '--version[print the version]' \
  '--help[show usage]'
