# fish completion for material-lab
set -l presets flat stone fabric organic coated-metal bare-metal
set -l formats glb usdz unreal unity-hdrp godot blender
complete -c material-lab -l input -r -F -d 'Source image'
complete -c material-lab -l output -r -F -d 'Output bundle, folder or file'
complete -c material-lab -l catalog -r -F -d 'Catalog JSON'
complete -c material-lab -l watch -r -a '(__fish_complete_directories)' -d 'Folder to watch'
complete -c material-lab -l validate -r -F -d 'Bundle or capture to validate'
complete -c material-lab -l label -r -d 'Semantic label'
complete -c material-lab -l id -r -d 'Material id'
complete -c material-lab -l preset -x -a "$presets" -d 'Material prior'
complete -c material-lab -l height-strength -x -d 'Relief amplitude 0..0.5'
complete -c material-lab -l polarity -x -a '1 -1' -d 'Bright details raised or recessed'
complete -c material-lab -l normal-strength -x -d 'Normal intensity 0..16'
complete -c material-lab -l roughness -x -d 'Roughness prior 0..1'
complete -c material-lab -l roughness-variation -x -d 'Roughness variation 0..1'
complete -c material-lab -l ao-radius -x -d 'Occlusion radius (pixels)'
complete -c material-lab -l ao-strength -x -d 'Occlusion depth 0..4'
complete -c material-lab -l equalize -x -d 'Remove lighting 0..1'
complete -c material-lab -l seamless -x -d 'Tileable edge band 0..0.45'
complete -c material-lab -l seamless-mode -x -a 'cut blend' -d 'Tiling method'
complete -c material-lab -l repair-albedo -x -a 'off auto quilt blend' -d 'Rebuild the albedo to tile'
complete -c material-lab -l metalness -x -d 'Assigned metalness 0..1'
complete -c material-lab -l normal-dx -d 'DirectX green-down normals'
complete -c material-lab -l no-tile -d 'Do not wrap filters at the edges'
complete -c material-lab -l bent-normal -d 'Write a bent normal map'
complete -c material-lab -l learned -d 'Use the bundled learned-geometry model'
complete -c material-lab -l learned-normals -r -F -d 'Core ML model'
complete -c material-lab -l learned-cpu-only -d 'Run the model on the CPU'
complete -c material-lab -l guide-normals -r -F -d 'Precomputed +Y normals PNG'
complete -c material-lab -l guide-weight -x -d 'Learned geometry weight 0..1'
complete -c material-lab -l save-guide-normals -r -F -d 'Write the guide normals'
complete -c material-lab -l recipe -r -F -d 'Recipe JSON or bundle'
complete -c material-lab -l saved-recipe -x -d 'Recipe saved in the Mac app'
complete -c material-lab -l save-recipe -r -F -d 'Write the recipe as JSON'
complete -c material-lab -l also-export -x -a "$formats" -d 'Formats to export beside each bundle'
complete -c material-lab -l jobs -x -a '1 2 3 4' -d 'Parallel catalog items'
complete -c material-lab -l report -r -F -d 'Per-item JSON report'
complete -c material-lab -l keep-going -d 'Continue after a failed item'
complete -c material-lab -l include-unreviewed -d 'Include unreviewed catalog items'
complete -c material-lab -l info -r -a '(__fish_complete_directories)' -d 'Describe a bundle'
complete -c material-lab -l contact-sheet -r -a '(__fish_complete_directories)' -d 'One image of every map'
complete -c material-lab -l diff -r -a '(__fish_complete_directories)' -d 'Compare two bundles'
complete -c material-lab -l export -r -a '(__fish_complete_directories)' -d 'Export a bundle'
complete -c material-lab -l format -x -a "$formats" -d 'Export format'
complete -c material-lab -l json -d 'Machine-readable output'
complete -c material-lab -l version -d 'Print the version'
complete -c material-lab -l help -d 'Show usage'
complete -c material-lab -l relief-mask-r8 -r -F -d 'Raw 8-bit relief mask'
complete -c material-lab -l height-override-r16le -r -F -d 'Raw 16-bit authored height'
complete -c material-lab -l pre-upscale-exec -r -F -d 'Local upscaler executable'
complete -c material-lab -l pre-upscale-arg -x -d 'Upscaler argument'
complete -c material-lab -l pre-upscale-timeout -x -d 'Upscaler timeout (seconds)'
